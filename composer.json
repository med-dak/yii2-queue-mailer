{
  "name": "med-dak/yii2-queue-mailer",
  "description": "Queue mailer decorator for Yii2 framework",
  "type": "yii2-extension",
  "keywords": [
    "yii2",
    "async",
    "mailer",
    "queue"
  ],
  "homepage": "https://github.com/med-dak/yii2-queue-mailer",
  "license": "MIT",
  "authors": [
    {
      "name": "JB Boisseau",
      "email": "boisseau.jb@gmail.com",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/med-dak/yii2-queue-mailer/issues",
    "source": "https://github.com/med-dak/yii2-queue-mailer"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.3",
    "yiisoft/yii2": "22.0.x-dev"
  },
  "suggest": {
    "yiisoft/yii2-queue": "Provides a queue backend. Upstream 2.x targets Yii 2.0; use a Yii 2.2-compatible fork or any queue exposing push()."
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "yiisoft/yii2-symfonymailer": "^4.0"
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "autoload": {
    "psr-4": {
      "Jbboisseau\\Yii2\\QueueMailer\\": "./src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Jbboisseau\\Yii2\\QueueMailer\\Tests\\": "./tests"
    }
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  }
}
